{
  "manifest_version": 2,
  "name": "Deslop the Web",
  "version": "1.0.0",
  "description": "Collapses paragraphs full of typical AI slop phrasing. Runs fully locally, no LLM: a curated phrase list.",
  "browser_specific_settings": {
    "gecko": {
      "id": "deslop-the-web@dast",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "alarms",
    "https://raw.githubusercontent.com/*",
    "https://gist.githubusercontent.com/*"
  ],
  "background": {
    "scripts": [
      "scorer.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Deslop the Web",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "heuristics.js",
        "scorer.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "https://*/*"
  ]
}
